# Website Hunt configuration.
# Copy to .env and fill in. Never commit .env - it is gitignored.

# --- Database (required) ------------------------------------------------------
# Password for the Postgres container started by docker-compose.
DB_PASSWORD=change_me
# Connection string the app uses. For docker-compose the host is "database".
DATABASE_URL=postgresql://websitehunt_user:change_me@database:5432/websitehunt

# --- Sessions (required in production) ----------------------------------------
# Signs session cookies. The server refuses to start in production without it.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=

# --- Application --------------------------------------------------------------
NODE_ENV=production
PORT=5000
# Session cookies are HTTPS-only in production by default. If you serve the app
# over plain HTTP (for example a campus LAN event with no TLS), set this to
# false or nobody will be able to stay logged in.
COOKIE_SECURE=true

# --- Scoring ------------------------------------------------------------------
# Whether an iiit.ac.in host we cannot reach counts as a wrong guess (-25).
# Leave false unless the server runs on the campus network: many IIIT sites are
# intranet-only, and off campus they look unreachable even though they are valid
# targets. False means such a guess scores 0 instead of costing points.
PENALISE_UNVERIFIED_IIIT=false

# --- First-run seeding --------------------------------------------------------
# Set SEED_DATABASE=true for the first boot to create the admin account; there
# is no other way to get an admin, and the panel is unreachable without one.
SEED_DATABASE=false
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@iiit.ac.in
# Required when seeding. Minimum 8 characters; seeding aborts if unset.
ADMIN_PASSWORD=
# Optional: whitespace- or comma-separated starter websites. Defaults to a
# built-in list of well-known IIIT sites when unset.
SEED_WEBSITES=

# --- Google OAuth (optional) --------------------------------------------------
# Both must be set to enable the "Continue with Google" button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Monitoring (optional, `--profile with-monitoring`) -----------------------
GRAFANA_PASSWORD=change_me
