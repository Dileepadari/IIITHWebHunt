# Website Hunt Environment Configuration

# Database Configuration
DB_PASSWORD=secure_password_change_in_production
DATABASE_URL=postgresql://websitehunt_user:secure_password_change_in_production@localhost:5432/websitehunt

# Redis Configuration
REDIS_PASSWORD=redis_password_change_in_production
REDIS_URL=redis://:redis_password_change_in_production@localhost:6379

# Session Configuration
SESSION_SECRET=change_this_in_production_please

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Monitoring (Optional)
GRAFANA_PASSWORD=admin_change_me

# Application Configuration
NODE_ENV=production
PORT=5000

# SSL Configuration (if using HTTPS)
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem

# SMTP Configuration (for email notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_password

# Domain Configuration
DOMAIN=yourdomain.com
ADMIN_EMAIL=admin@yourdomain.com